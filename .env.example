# Optional: enables AI analysis for logs the rule engine can't explain.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Roles: comma-separated key:role pairs. Roles are developer, lead, admin.
# Leave empty for local development (everything is open).
API_KEYS=

# GitHub integration (webhook + PR comments)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

DB_PATH=data/pipelinedoctor.db
MAX_LOG_BYTES=2000000

# TinyFish Search Integration
TINYFISH_API_KEY=
TINYFISH_LOCATION=US
TINYFISH_LANGUAGE=en
TINYFISH_ENABLED=true
